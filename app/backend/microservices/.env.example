# KApp backend - environment template.
#
#   cp .env.example .env     # .env is gitignored; this file must never hold a real value
#
# Docker Compose reads .env from this directory automatically. Every value below is a
# PLACEHOLDER. Nothing here is a secret, and nothing here should ever become one.
#
# ---------------------------------------------------------------------------------
# Generating the RS256 keypair that auth-service signs with
# ---------------------------------------------------------------------------------
# Access tokens are RS256, so the private key signs and the public key is published at
# /.well-known/jwks.json for the other services to verify against. Generate a pair and
# base64-encode each PEM onto a single line (a multi-line PEM cannot be an env var):
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out kapp-private.pem
#   openssl rsa -in kapp-private.pem -pubout -out kapp-public.pem
#
#   # macOS (no -w flag on BSD base64):
#   echo "KAPP_JWT_PRIVATE_KEY=$(base64 -i kapp-private.pem | tr -d '\n')" >> .env
#   echo "KAPP_JWT_PUBLIC_KEY=$(base64 -i kapp-public.pem  | tr -d '\n')"  >> .env
#
#   # Linux:
#   echo "KAPP_JWT_PRIVATE_KEY=$(base64 -w0 kapp-private.pem)" >> .env
#   echo "KAPP_JWT_PUBLIC_KEY=$(base64 -w0 kapp-public.pem)"   >> .env
#
# Then delete the .pem files, or keep them outside the repo. Each developer generates
# their own pair; tokens are not meant to be portable between laptops.


# =================================================================================
# auth-service (8081, database kapp_auth)
# =================================================================================

# OPTIONAL locally, REQUIRED anywhere real. Base64 of the private RSA PEM. Left blank,
# auth-service generates an ephemeral pair at startup and logs a warning - which means
# every restart invalidates all tokens already issued, including the ones sitting in the
# mobile clients' keychains. Set it as soon as that starts costing you logins.
KAPP_JWT_PRIVATE_KEY=

# OPTIONAL locally, REQUIRED anywhere real. Base64 of the matching public RSA PEM,
# served as the JWKS document. Must be the pair of the key above or every token issued
# fails verification at the other services.
KAPP_JWT_PUBLIC_KEY=

# OPTIONAL, defaults shown. Identify and bound the tokens auth-service mints.
# KAPP_JWT_KEY_ID=kapp-signing-key
# KAPP_JWT_TTL=1h
# KAPP_JWT_ISSUER=https://kapp.konradlorenz.edu.co


# =================================================================================
# auth-service and user-service (shared)
# =================================================================================

# REQUIRED on both. Shared secret for POST /internal/users, the endpoint auth-service
# calls to create the profile during registration. It is the only thing standing
# between that endpoint and anyone who can reach the compose network, so the two
# services must hold the same value and it must not be the placeholder in production.
KAPP_INTERNAL_TOKEN=replace-with-a-long-random-string


# =================================================================================
# api-gateway (8080 - the only JVM port published to the host)
# =================================================================================



# =================================================================================
# All services
# =================================================================================

# OPTIONAL, defaults to INFO. Log level for the co.edu.konradlorenz.kapp packages only;
# framework logging is untouched. Use DEBUG while chasing something, not by default -
# seven services at DEBUG makes `docker compose logs` unreadable.
KAPP_LOG_LEVEL=INFO


# =================================================================================
# Values compose sets for you - listed for reference, do NOT put them in .env
# =================================================================================
# These are hardcoded per service in docker-compose.yml because they are topology, not
# configuration. Overriding them in .env has no effect; edit the compose file instead.
#
#   SERVER_PORT      8081 auth / 8082 user / 8083 semaphore / 8084 schedule / 8085 map
#   MONGODB_URI      mongodb://mongo:27017/kapp_<service>?replicaSet=rs0
#                    (replicaSet is not decoration - transactions need it)
#   KAPP_JWKS_URI    http://auth-service:8081/.well-known/jwks.json
#   EUREKA_URI       http://discovery-server:8761/eureka/
#   EUREKA_ENABLED   true in compose; the tests set it false to skip registration
#
# Connecting to Mongo from the HOST (Compass, mongosh) needs a direct connection,
# because the set advertises its member as `mongo:27017`, which the host cannot resolve:
#
#   mongodb://localhost:27017/?directConnection=true


# =================================================================================
# MongoDB authentication - deliberately OFF for local development
# =================================================================================
# Enabling auth on a replica set also requires internal member authentication (a
# --keyFile or x.509), which a single-node dev container does not carry. The Mongo port
# is only reachable from the compose network and from localhost, so the local stack
# runs unauthenticated. Do not copy this arrangement to a deployed environment.
#
# If you do add auth, uncomment both, wire the keyFile, and switch MONGODB_URI to
# mongodb://<user>:<password>@mongo:27017/kapp_<service>?replicaSet=rs0&authSource=admin
#
# MONGO_INITDB_ROOT_USERNAME=kapp
# MONGO_INITDB_ROOT_PASSWORD=replace-me-never-commit-a-real-password

# ─────────────────────────────────────────────────────────────────────────────
# Registration and e-mail verification (auth-service)
# ─────────────────────────────────────────────────────────────────────────────

# Only this domain may register through /auth/register. Guest registration
# (/auth/register/guest) accepts any domain and grants ROLE_GUEST, which can
# read the campus map and nothing else.
KAPP_ALLOWED_EMAIL_DOMAIN=konradlorenz.edu.co

# Off by default, on purpose. There is no SMTP relay yet, and registration is
# the front door of the product: requiring an e-mail nobody can send would
# block the mobile team and every tester. With it off, accounts are created
# ACTIVE and can sign in immediately, while emailVerified stays false because
# nothing was actually verified. Turn it on as soon as mail works.
KAPP_REQUIRE_EMAIL_VERIFICATION=false

# Base URL placed in the verification link sent to the user.
KAPP_VERIFICATION_LINK_BASE=http://localhost:8080/auth/verify

# Leave SPRING_MAIL_HOST blank and verification e-mails are written to the log
# rather than sent. That is what makes the flag above safe to turn on locally.
#
# Three ways to fill this in, best first:
#   1. Microsoft Graph Mail.Send on the same Entra app registration used for
#      login. No SMTP, no password to rotate. One request to IT instead of two.
#   2. An institutional relay: a service mailbox with SMTP AUTH enabled,
#      smtp.office365.com:587 with STARTTLS.
#   3. A transactional provider (Resend, Brevo) for the alpha. Sending as
#      @konradlorenz.edu.co from one needs SPF and DKIM records that only IT
#      can add; without them you send from the provider's domain.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# MongoDB credentials — one user per service
# ─────────────────────────────────────────────────────────────────────────────
#
# Without MONGO_ROOT_PASSWORD the container starts UNAUTHENTICATED and every service
# reaches every database. That is how this project ran until now: the separation between
# databases was a convention the code respected, not a rule the server enforced.
#
# Generate a full set with:
#   ./scripts/generate-dev-secrets.sh > .env
#
# Each service user is created inside the database it owns, so that database is also its
# authSource. A leaked credential therefore opens exactly one database.

MONGO_ROOT_USER=kapp_root
MONGO_ROOT_PASSWORD=
MONGO_AUTH_PASSWORD=
MONGO_USER_PASSWORD=
MONGO_SEMAPHORE_PASSWORD=
MONGO_SCHEDULE_PASSWORD=
MONGO_MAP_PASSWORD=

# One whole connection string per service. This is the single point that decides where a
# service stores its data, which is what makes moving one database elsewhere — or all of
# them to Atlas — a configuration change rather than an architectural one.
#
# Unset, each service falls back to an unauthenticated local Mongo.
#
# Local, authenticated:
#   MONGO_AUTH_URI=mongodb://kapp_auth_user:PASSWORD@mongo:27017/kapp_auth?replicaSet=rs0&authSource=kapp_auth
#
# Atlas (note +srv, no replicaSet parameter — the SRV record carries it):
#   MONGO_AUTH_URI=mongodb+srv://kapp_auth_user:PASSWORD@cluster.xxxxx.mongodb.net/kapp_auth?retryWrites=true&w=majority
#
# With all five pointing at Atlas, run `docker compose --profile cloud up -d`: it starts
# every service and no local database.

MONGO_AUTH_URI=
MONGO_USER_URI=
MONGO_SEMAPHORE_URI=
MONGO_SCHEDULE_URI=
MONGO_MAP_URI=
